@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "MatBu";
    var currentUserName = ViewData["UserName"]?.ToString() ?? "Benutzer";
    var initials = string.Concat(currentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => char.ToUpperInvariant(part[0])).Take(2));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b7f8a" />
    <title>@(ViewData["Title"] is string title ? $"{title} · MatBu" : "MatBu")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" href="~/branding/matbu-app-icon.png" />
    <link rel="apple-touch-icon" href="~/branding/matbu-app-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="stylesheet" href="~/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/schedule.css" asp-append-version="true" />
</head>
<body>
    <svg class="ui-icon-sprite" aria-hidden="true">
        <symbol id="icon-play" viewBox="0 0 24 24"><path d="m7 4 13 8-13 8V4Z" /></symbol>
        <symbol id="icon-folder" viewBox="0 0 24 24"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4H9l2 2h7.5A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-10Z" /></symbol>
        <symbol id="icon-pencil" viewBox="0 0 24 24"><path d="M14.5 5.5 18.5 9.5M4 20l4.5-1 10-10a2.8 2.8 0 0 0-4-4l-10 10L4 20Z" /></symbol>
        <symbol id="icon-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5" /></symbol>
        <symbol id="icon-log" viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6V3Zm9 0v4h4M9 11h6m-6 4h6" /></symbol>
        <symbol id="icon-retry" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5m10-1a7 7 0 0 0-12-4L4 10m1 3a7 7 0 0 0 12 4l3-3" /></symbol>
        <symbol id="icon-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M5 20h14" /></symbol>
        <symbol id="icon-terminal" viewBox="0 0 24 24"><path d="M4 5h16v14H4V5Zm4 4 3 3-3 3m5 0h3" /></symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></symbol>
        <symbol id="icon-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></symbol>
        <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5m4-4 4-4-4-4m4 4H9" /></symbol>
    </svg>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand"><img class="brand-mark" src="~/branding/matbu-app-icon.png" alt="" width="38" height="38" /><div><strong>MatBu</strong><span>Backup &amp; Sync</span></div></div>
            <nav>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index"><span>⌂</span>Dashboard</a>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Tasks") == true || ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Jobs") == true || ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Restore") == true ? "active" : "")" asp-page="/Tasks/Index"><span>↻</span>Jobs</a>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Objects") == true ? "active" : "")" asp-page="/Objects/Index"><span>◈</span>Objects</a>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Instances") == true ? "active" : "")" asp-page="/Instances/Index"><span>⇄</span>Instanzen</a>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Users") == true ? "active" : "")" asp-page="/Users"><span>♙</span>Benutzer</a>
                <a class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Protocol") == true ? "active" : "")" asp-page="/Protocol/Index"><span>▤</span>Protokoll</a>
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-account">
                    <div class="avatar">@initials</div>
                    <div class="sidebar-account-copy"><strong>@currentUserName</strong><small>Lokales Konto</small></div>
                </div>
                <div class="sidebar-tools" aria-label="Benutzer und Darstellung">
                    <button class="sidebar-tool theme-toggle" type="button" data-theme-toggle aria-label="Darstellung: System" title="Darstellung: System">◐</button>
                    <a class="sidebar-tool" asp-page="/Settings/Notifications" aria-label="Benachrichtigungen" title="Benachrichtigungen"><svg class="ui-icon"><use href="#icon-bell"></use></svg></a>
                    <form method="post" action="/Logout" class="sidebar-logout-form"><button class="sidebar-tool danger" type="submit" aria-label="Abmelden" title="Abmelden"><svg class="ui-icon"><use href="#icon-logout"></use></svg></button></form>
                </div>
                <div class="connection"><i></i><span>System online</span></div>
                <small>v0.2.0 · local</small>
            </div>
        </aside>
        <main class="main">
            <header class="topbar">
                <div class="topbar-page-title"><h1>@pageTitle</h1></div>
                <div class="mobile-topbar-tools">
                    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Darstellung: System" title="Darstellung: System">◐</button>
                    <div class="avatar" title="@currentUserName">@initials</div>
                    <form method="post" action="/Logout"><button class="mobile-logout" type="submit" aria-label="Abmelden" title="Abmelden"><svg class="ui-icon"><use href="#icon-logout"></use></svg></button></form>
                </div>
            </header>
            <section class="content">@RenderBody()</section>
        </main>
    </div>
    <script src="~/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
