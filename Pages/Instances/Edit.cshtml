@page
@model MatBu.Pages.Instances.EditModel
@{ ViewData["Title"] = Model.Id is null ? "Secondary erstellen" : Model.IsPrimary ? "Primary bearbeiten" : "Secondary bearbeiten"; ViewData["UserName"] = Model.CurrentUser?.UserName; }

<div class="page-heading"><div><p class="eyebrow">Gateway</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="panel form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-grid">
        <div class="field" style="grid-column:1/-1">
            <label asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" required placeholder="Standort B" />
        </div>
        @if (Model.IsPrimary)
        {
            <div class="field" style="grid-column:1/-1">
                <label>Rolle</label>
                <input value="Primary · lokale Installation" readonly />
                <small>Die lokale Primary wird von MatBu verwaltet. Ihre Rolle kann nicht geändert werden.</small>
            </div>
        }
        else
        {
            <div class="field" style="grid-column:1/-1">
                <label>Rolle</label>
                <input value="Secondary · ausgehende Verbindung" readonly />
            </div>
            <div class="field" style="grid-column:1/-1">
                <label asp-for="Input.Endpoint">Von der Secondary erreichbare Primary-Adresse</label>
                <input asp-for="Input.Endpoint" placeholder="https://backup.example.de" required />
                <small>Im Internet die öffentliche HTTPS-Adresse der Primary verwenden. Die Secondary benötigt keinen eingehenden Port.</small>
            </div>
            <div class="field"><label><input asp-for="Input.Enabled" /> Aktiviert</label></div>
        }
    </div>
    <div class="form-actions button-row">
        <button class="button primary" type="submit">Speichern</button>
        <a class="button" asp-page="/Instances/Index">Zurück</a>
        @if (Model.Id is not null && !Model.IsPrimary)
        {
            <a class="button" asp-page="/Instances/Setup" asp-route-id="@Model.Id">Setup &amp; Compose</a>
        }
    </div>
</form>
