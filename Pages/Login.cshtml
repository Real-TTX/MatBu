@page
@model MatBu.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Anmelden";
}
<!DOCTYPE html><html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="theme-color" content="#0b7f8a" /><title>Anmelden · MatBu</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg" /><link rel="icon" type="image/png" href="~/branding/matbu-app-icon.png" /><link rel="apple-touch-icon" href="~/branding/matbu-app-icon.png" /><link rel="manifest" href="~/site.webmanifest" /><link rel="stylesheet" href="~/styles.css" asp-append-version="true" /></head><body><div class="login-page"><div class="login-card"><img class="brand-mark" src="~/branding/matbu-app-icon.png" alt="MatBu" width="52" height="52" /><p class="eyebrow">MatBu · lokal</p><h1>Anmelden</h1><p class="login-copy">Melde dich an, um deine Backup-Infrastruktur zu verwalten.</p>@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="login-error">@Model.ErrorMessage</div> }<form method="post" class="form"><div class="field"><label asp-for="UserName">Benutzername</label><input asp-for="UserName" autocomplete="username" required /></div><div class="field"><label asp-for="Password">Passwort</label><input asp-for="Password" type="password" autocomplete="current-password" required /></div><button class="button primary" type="submit">Anmelden</button></form><small>Erststart: admin / admin</small></div></div><script src="~/theme.js" asp-append-version="true"></script></body></html>
