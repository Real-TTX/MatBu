@page
@model MatBu.Pages.Tasks.EditModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Id is null ? "Job erstellen" : "Job bearbeiten";
    ViewData["UserName"] = Model.CurrentUser?.UserName;
    var sourceObjects = Model.Objects.Where(item => item.Direction != ObjectDirection.Target).ToList();
    var targetObjects = Model.Objects.Where(item => item.Direction != ObjectDirection.Source).ToList();
    var sourceOnlyObjects = Model.Objects.Where(item => item.Direction == ObjectDirection.Source).ToList();
    var weekdays = new[]
    {
        (Value: nameof(DayOfWeek.Monday), Short: "Mo", Name: "Montag"),
        (Value: nameof(DayOfWeek.Tuesday), Short: "Di", Name: "Dienstag"),
        (Value: nameof(DayOfWeek.Wednesday), Short: "Mi", Name: "Mittwoch"),
        (Value: nameof(DayOfWeek.Thursday), Short: "Do", Name: "Donnerstag"),
        (Value: nameof(DayOfWeek.Friday), Short: "Fr", Name: "Freitag"),
        (Value: nameof(DayOfWeek.Saturday), Short: "Sa", Name: "Samstag"),
        (Value: nameof(DayOfWeek.Sunday), Short: "So", Name: "Sonntag")
    };
}

<div class="page-heading">
    <div><p class="eyebrow">Backup-Job</p><h1>@ViewData["Title"]</h1><p>Definiere Quelle, Ziel, Methode, Zeitplan und Retention.</p></div>
</div>

<form method="post" class="panel form task-editor">
    <div asp-validation-summary="All" class="validation-summary"></div>
    @if (Model.Error is not null)
    {
        <div class="login-error">@Model.Error</div>
    }
    <div class="form-grid">
        <div class="task-section-heading">
            <span aria-hidden="true">A</span><div><h2>Allgemein</h2><p>Name und optionale Tags für Filter und Kundenzuordnung.</p></div>
        </div>
        <div class="field">
            <label asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" required />
        </div>
        <div class="field tag-field">
            <div class="field-label-row"><label>Tags</label><a asp-page="/Tasks/Labels/Index">Tags verwalten</a></div>
            <div class="tag-selector">
                @foreach (var label in Model.JobLabels)
                {
                    <label class="tag-choice" style="--tag-color:@label.Color">
                        <input type="checkbox" name="SelectedLabelIds" value="@label.Id" checked="@Model.SelectedLabelIds.Contains(label.Id)" />
                        <span>@label.Name</span>
                    </label>
                }
                @if (Model.JobLabels.Count == 0) { <small>Noch keine Tags vorhanden.</small> }
            </div>
            <span asp-validation-for="SelectedLabelIds" class="field-error"></span>
        </div>
        <div class="task-section-heading">
            <span aria-hidden="true">↔</span><div><h2>Datenweg</h2><p>Wo liegen die Quelldaten und welche Instanz schreibt sie an welches Ziel?</p></div>
        </div>
        <div class="field">
            <label asp-for="Input.SourceId">Quelle</label>
            <select asp-for="Input.SourceId" id="source-object">
                <option value="">Bitte wählen</option>
                @foreach (var instance in Model.Instances)
                {
                    var items = sourceObjects.Where(item => item.InstanceId == instance.Id).ToList();
                    if (items.Count == 0) continue;
                    <optgroup label="@instance.Name · @instance.Role">
                        @foreach (var item in items)
                        {
                            <option value="@item.Id" data-kind="@item.Kind">@item.Name · @item.Kind</option>
                        }
                    </optgroup>
                }
            </select>
            <small>Die Instanz zeigt, in welchem Netzwerk der Zugriff ausgeführt wird.</small>
        </div>
        <div class="field source-selection-field" id="source-selection-field">
            <label>Zu sichernde Inhalte</label>
            <button class="source-picker-input" id="source-picker-open" type="button">
                <span><strong id="source-picker-title">Gesamtes Object</strong><small id="source-picker-summary">Alle Ordner und Dateien werden gesichert</small></span>
                <svg class="ui-icon"><use href="#icon-folder"></use></svg>
            </button>
            <div id="selected-source-inputs">
                @foreach (var path in Model.SelectedSourcePaths) { <input type="hidden" name="SelectedSourcePaths" value="@path" /> }
            </div>
            <small>Optional: Mehrere Ordner auswählen. Eine leere Auswahl sichert das vollständige Object.</small>
        </div>
        <div class="field">
            <label asp-for="Input.TargetId">Ziel</label>
            <select asp-for="Input.TargetId" id="target-object">
                <option value="">Bitte wählen</option>
                @foreach (var instance in Model.Instances)
                {
                    var items = targetObjects.Where(item => item.InstanceId == instance.Id).ToList();
                    if (items.Count == 0) continue;
                    <optgroup label="@instance.Name · @instance.Role">
                        @foreach (var item in items)
                        {
                            <option value="@item.Id" data-kind="@item.Kind">@item.Name · @item.Kind</option>
                        }
                    </optgroup>
                }
                @if (sourceOnlyObjects.Count > 0)
                {
                    <optgroup label="Nicht als Ziel freigegeben">
                        @foreach (var item in sourceOnlyObjects)
                        {
                            var instanceName = Model.Instances.FirstOrDefault(instance => instance.Id == item.InstanceId)?.Name ?? "Unbekannte Instanz";
                            <option disabled>@item.Name · @instanceName · nur Quelle</option>
                        }
                    </optgroup>
                }
            </select>
            @if (targetObjects.Count == 0)
            {
                <small class="field-warning">Kein Ziel freigegeben. Öffne <a asp-page="/Objects/Index">Objects</a> und stelle beim gewünschten SMB-Object die Richtung auf „Ziel“ oder „Beides“.</small>
            }
            else
            {
                <small>Ziele sind nach der Instanz gruppiert, die auf das jeweilige Netzwerk zugreift. <a asp-page="/Objects/Index">Objects verwalten</a></small>
            }
        </div>
        <div class="task-section-heading">
            <span aria-hidden="true">◆</span><div><h2>Backupverfahren</h2><p>Nur passende Optionen zur gewählten Methode werden angezeigt.</p></div>
        </div>
        <div class="field">
            <label asp-for="Input.Method">Backup-Methode</label>
            <select asp-for="Input.Method" id="backup-method">
                <option value="ReverseIncremental">Reverse Incremental (empfohlen)</option>
                <option value="ForwardIncremental">Forward Incremental</option>
                <option value="Differential">Differential</option>
                <option value="ProxmoxNative" id="proxmox-native-option">Proxmox Native (PBS/CBT)</option>
                <option value="Full">Full</option>
            </select>
            <small id="backup-method-help">Reverse Incremental hält den aktuellen Stand direkt lesbar und überträgt nur geänderte Blöcke.</small>
            <span asp-validation-for="Input.Method" class="field-error"></span>
        </div>
        <div class="field" id="chunk-size-field">
            <label asp-for="Input.ChunkSizeMiB">Chunkgröße</label>
            <select asp-for="Input.ChunkSizeMiB" id="chunk-size">
                @foreach (var chunkSize in Model.AllowedChunkSizesMiB)
                {
                    <option value="@chunkSize">@chunkSize MiB</option>
                }
            </select>
            <small>Größere Chunks reduzieren Verwaltungsaufwand, kleinere Chunks erhöhen die Wiederverwendung.</small>
            <span asp-validation-for="Input.ChunkSizeMiB" class="field-error"></span>
        </div>
        <div class="field" id="compression-field">
            <label asp-for="Input.Compression">Kompression</label>
            <select asp-for="Input.Compression" id="compression">
                <option value="None">Aus – für bereits komprimierte VM-Backups</option>
                <option value="Fast">Schnell – hoher Durchsatz (empfohlen)</option>
                <option value="Balanced">Ausgewogen</option>
                <option value="Maximum">Maximum – höchste CPU-Last</option>
            </select>
            <small>Full-Archive werden während der Erstellung gestreamt komprimiert. Für VMDK/ZIP ist „Aus“ oft schneller.</small>
            <span asp-validation-for="Input.Compression" class="field-error"></span>
        </div>
        @if (Model.CanManageConsistency)
        {
            <div class="task-section-heading" id="consistency-section-heading">
                <span aria-hidden="true">✓</span><div><h2>Anwendungskonsistenz</h2><p>Nur für Full-Backups: Container während der Aufnahme pausieren oder Hooks ausführen.</p></div>
            </div>
            <div class="field consistency-main-field" data-consistency-section>
                <label asp-for="Input.ConsistencyMode">Anwendungskonsistenz</label>
                <select asp-for="Input.ConsistencyMode" id="consistency-mode">
                    <option value="None">Keine · Crash-konsistent</option>
                    <option value="DockerPause">Docker-Container während Aufnahme pausieren</option>
                    <option value="DockerExec">Pre-/Post-Kommando im Docker-Container</option>
                </select>
                <small>Die Anwendung wird nur während der lokalen Quellaufnahme angehalten – nicht während der Übertragung.</small>
                <span asp-validation-for="Input.ConsistencyMode" class="field-error"></span>
            </div>
            <div class="field consistency-detail-field" data-consistency-section data-consistency-detail>
                <label asp-for="Input.ConsistencyContainerNames">Docker-Container</label>
                <input asp-for="Input.ConsistencyContainerNames" placeholder="z. B. vmware-backup oder db,app" />
                <small>Pause: mehrere Namen mit Komma trennen. Exec: genau ein Container.</small>
                <span asp-validation-for="Input.ConsistencyContainerNames" class="field-error"></span>
            </div>
            <div class="field consistency-exec-field" data-consistency-section data-consistency-exec>
                <label asp-for="Input.PreBackupCommand">Pre-Backup-Kommando</label>
                <input asp-for="Input.PreBackupCommand" placeholder="z. B. pg_start_backup" autocomplete="off" />
                <small>Wird über <code>/bin/sh -c</code> innerhalb des Containers ausgeführt.</small>
                <span asp-validation-for="Input.PreBackupCommand" class="field-error"></span>
            </div>
            <div class="field consistency-exec-field" data-consistency-section data-consistency-exec>
                <label asp-for="Input.PostBackupCommand">Post-Backup-Kommando</label>
                <input asp-for="Input.PostBackupCommand" placeholder="Anwendung wieder freigeben" autocomplete="off" />
                <small>Läuft auch dann als Cleanup, wenn die Quellaufnahme fehlschlägt.</small>
            </div>
            <div class="field consistency-detail-field" data-consistency-section data-consistency-detail>
                <label asp-for="Input.ConsistencyTimeoutSeconds">Hook-Timeout</label>
                <div class="input-suffix"><input asp-for="Input.ConsistencyTimeoutSeconds" type="number" min="5" max="900" /><span>Sekunden</span></div>
                <span asp-validation-for="Input.ConsistencyTimeoutSeconds" class="field-error"></span>
            </div>
        }
        else
        {
            <input asp-for="Input.ConsistencyMode" type="hidden" />
            <input asp-for="Input.ConsistencyContainerNames" type="hidden" />
            <input asp-for="Input.PreBackupCommand" type="hidden" />
            <input asp-for="Input.PostBackupCommand" type="hidden" />
            <input asp-for="Input.ConsistencyTimeoutSeconds" type="hidden" />
        }
        <div class="task-section-heading">
            <span aria-hidden="true">◷</span><div><h2>Zeitplan</h2><p>Einfaches Intervall, täglich oder an mehreren ausgewählten Wochentagen.</p></div>
        </div>
        <section class="schedule-editor" aria-labelledby="schedule-heading">
            <div class="schedule-editor-heading">
                <div><label id="schedule-heading">Automatische Ausführung</label><small>Der nächste Start wird nach dem Speichern direkt berechnet.</small></div>
                <strong id="schedule-summary" aria-live="polite"></strong>
            </div>
            <div class="schedule-mode-options">
                <label class="schedule-mode"><input asp-for="ScheduleKind" type="radio" value="Interval" /><span><strong>Intervall</strong><small>Alle X Minuten oder Stunden</small></span></label>
                <label class="schedule-mode"><input asp-for="ScheduleKind" type="radio" value="Daily" /><span><strong>Täglich</strong><small>Jeden Tag zur gleichen Uhrzeit</small></span></label>
                <label class="schedule-mode"><input asp-for="ScheduleKind" type="radio" value="Weekly" /><span><strong>Wochentage</strong><small>Ein oder mehrere Tage zur gleichen Uhrzeit</small></span></label>
            </div>
            <div class="schedule-details">
                <div class="field" id="schedule-interval-field">
                    <label asp-for="ScheduleInterval">Ausführen alle</label>
                    <div class="schedule-inline">
                        <input asp-for="ScheduleInterval" type="number" min="1" max="1440" inputmode="numeric" />
                        <select asp-for="ScheduleIntervalUnit" id="schedule-interval-unit">
                            <option value="Minutes">Minuten</option>
                            <option value="Hours">Stunden</option>
                        </select>
                    </div>
                </div>
                <div class="field weekday-field" id="schedule-weekday-field">
                    <label>An diesen Tagen</label>
                    <input type="hidden" name="ScheduleWeekdays" value="" />
                    <div class="weekday-selector">
                        @foreach (var day in weekdays)
                        {
                            <label class="weekday-choice" title="@day.Name">
                                <input type="checkbox" name="ScheduleWeekdays" value="@day.Value" checked="@Model.ScheduleWeekdays.Contains(day.Value)" />
                                <span>@day.Short</span>
                            </label>
                        }
                    </div>
                    <small>Mehrfachauswahl möglich, zum Beispiel Dienstag und Sonntag.</small>
                </div>
                <div class="field" id="schedule-time-field">
                    <label asp-for="ScheduleTime">Start um</label>
                    <input asp-for="ScheduleTime" id="schedule-time" type="time" step="60" />
                </div>
            </div>
            <span asp-validation-for="ScheduleKind" class="field-error"></span>
        </section>
        <div class="task-section-heading">
            <span aria-hidden="true">↻</span><div><h2>Aufbewahrung und Wiederholung</h2><p>Versionen begrenzen und festlegen, wie MatBu nach Verbindungsfehlern erneut versucht.</p></div>
        </div>
        <div class="field">
            <label asp-for="Input.Retention">Retention</label>
            <select asp-for="Input.Retention">
                <option>30 Tage</option>
                <option>12 Monate</option>
                <option>8 Wochen</option>
            </select>
            <small>Versionen werden nach dieser Zeit automatisch aus dem Backup-Ziel entfernt.</small>
        </div>
        <div class="field">
            <label asp-for="Input.MaxRetryAttempts">Maximale Versuche</label>
            <input asp-for="Input.MaxRetryAttempts" id="max-retry-attempts" type="number" min="1" max="20" inputmode="numeric" />
            <small>Inklusive Erstversuch. Mit 1 sind automatische Wiederholungen deaktiviert.</small>
            <span asp-validation-for="Input.MaxRetryAttempts" class="field-error"></span>
        </div>
        <div class="field" id="retry-delay-field">
            <label asp-for="Input.RetryDelayMinutes">Retry-Basiswartezeit</label>
            <div class="input-suffix"><input asp-for="Input.RetryDelayMinutes" type="number" min="1" max="1440" inputmode="numeric" /><span>Minuten</span></div>
            <small>Die Wartezeit verdoppelt sich nach jedem fehlgeschlagenen Versuch.</small>
            <span asp-validation-for="Input.RetryDelayMinutes" class="field-error"></span>
        </div>
        <div class="field job-enabled-field">
            <label class="toggle-label"><input asp-for="Input.Enabled" /> Job aktiviert</label>
            <small>Deaktivierte Jobs können weiterhin manuell gestartet werden.</small>
        </div>
    </div>
    <div class="form-actions button-row task-form-actions">
        <button class="button primary" type="submit">Speichern</button>
        <a class="button" asp-page="/Tasks/Index">Zurück</a>
    </div>
</form>

<dialog class="source-picker-dialog" id="source-picker-dialog">
    <div class="source-picker-shell">
        <div class="source-picker-header"><div><span class="route-label">Quell-Object</span><h2>Backup-Ordner auswählen</h2></div><button class="icon-action" id="source-picker-close" type="button" aria-label="Dialog schließen">×</button></div>
        <div class="source-picker-toolbar"><button class="button" id="source-picker-all" type="button">Gesamtes Object</button><span id="source-picker-count">Keine Einschränkung</span></div>
        <div class="source-tree" id="source-tree"><div class="empty">Ordner werden beim Öffnen geladen.</div></div>
        <div class="source-picker-error" id="source-picker-error" hidden></div>
        <div class="form-actions"><button class="button primary" id="source-picker-apply" type="button">Auswahl übernehmen</button><button class="button" id="source-picker-cancel" type="button">Abbrechen</button></div>
    </div>
</dialog>

<script>
    (() => {
        const method = document.getElementById('backup-method');
        const source = document.getElementById('source-object');
        const target = document.getElementById('target-object');
        const chunkField = document.getElementById('chunk-size-field');
        const chunkSize = document.getElementById('chunk-size');
        const compressionField = document.getElementById('compression-field');
        const compression = document.getElementById('compression');
        const methodHelp = document.getElementById('backup-method-help');
        const nativeOption = document.getElementById('proxmox-native-option');
        const sourceSelectionField = document.getElementById('source-selection-field');
        if (!method || !chunkField || !chunkSize || !compressionField || !compression) return;

        const updateChunkSelection = () => {
            const isChunked = ['ForwardIncremental', 'Differential', 'ReverseIncremental'].includes(method.value);
            const isFull = method.value === 'Full';
            chunkField.hidden = !isChunked;
            chunkSize.disabled = !isChunked;
            compressionField.hidden = !isFull;
            compression.disabled = !isFull;
            if (methodHelp) methodHelp.textContent = ({
                ReverseIncremental: 'Aktueller Stand bleibt direkt lesbar; nur geänderte Blöcke werden übertragen.',
                ForwardIncremental: 'Jede Version speichert die Änderungen zur unmittelbar vorherigen Version.',
                Differential: 'Jede Version speichert die Änderungen seit dem letzten Full-Stand.',
                ProxmoxNative: 'Proxmox erstellt das Backup nativ und übergibt es an den konfigurierten PBS-Speicher.',
                Full: 'Jeder Lauf erzeugt ein vollständiges, optional komprimiertes Archiv.'
            })[method.value] || '';
        };

        method.addEventListener('change', updateChunkSelection);
        const updateNativeRoute = () => {
            const sourceKind = source?.selectedOptions?.[0]?.dataset.kind;
            const targetKind = target?.selectedOptions?.[0]?.dataset.kind;
            const nativeRoute = sourceKind === 'Proxmox' && targetKind === 'ProxmoxBackupServer';
            if (nativeOption) {
                nativeOption.hidden = !nativeRoute;
                nativeOption.disabled = !nativeRoute;
            }
            if (nativeRoute) method.value = 'ProxmoxNative';
            else if (method.value === 'ProxmoxNative') method.value = 'ReverseIncremental';
            if (sourceSelectionField) sourceSelectionField.hidden = !source?.value || !['LocalFolder', 'Smb', 'DockerVolume', 'Proxmox'].includes(sourceKind);
            method.dispatchEvent(new Event('change'));
        };
        source?.addEventListener('change', updateNativeRoute);
        target?.addEventListener('change', updateNativeRoute);
        updateNativeRoute();
    })();

    (() => {
        const mode = document.getElementById('consistency-mode');
        const method = document.getElementById('backup-method');
        if (!mode || !method) return;
        const heading = document.getElementById('consistency-section-heading');
        const sectionFields = document.querySelectorAll('[data-consistency-section]');
        const details = document.querySelectorAll('[data-consistency-detail]');
        const execFields = document.querySelectorAll('[data-consistency-exec]');
        const update = () => {
            const full = method.value === 'Full';
            if (heading) heading.hidden = !full;
            sectionFields.forEach(element => {
                element.hidden = !full;
                element.querySelectorAll('input, select').forEach(control => control.disabled = !full);
            });
            if (!full) return;
            const enabled = mode.value !== 'None';
            const exec = mode.value === 'DockerExec';
            details.forEach(element => {
                element.hidden = !enabled;
                element.querySelectorAll('input, select').forEach(control => control.disabled = !enabled);
            });
            execFields.forEach(element => {
                element.hidden = !exec;
                element.querySelectorAll('input, select').forEach(control => control.disabled = !exec);
            });
            mode.setCustomValidity('');
        };
        mode.addEventListener('change', update);
        method.addEventListener('change', update);
        update();
    })();

    (() => {
        const kinds = [...document.querySelectorAll('input[name="ScheduleKind"]')];
        const intervalField = document.getElementById('schedule-interval-field');
        const timeField = document.getElementById('schedule-time-field');
        const weekdayField = document.getElementById('schedule-weekday-field');
        const intervalUnit = document.getElementById('schedule-interval-unit');
        const intervalInput = document.getElementById('ScheduleInterval');
        const timeInput = document.getElementById('schedule-time');
        const weekdayInputs = [...document.querySelectorAll('input[type="checkbox"][name="ScheduleWeekdays"]')];
        const weekdaySentinel = document.querySelector('input[type="hidden"][name="ScheduleWeekdays"]');
        const summary = document.getElementById('schedule-summary');
        if (!kinds.length || !intervalField || !timeField || !weekdayField) return;

        const updateScheduleFields = () => {
            const kind = kinds.find(input => input.checked)?.value ?? 'Daily';
            const interval = kind === 'Interval';
            intervalField.hidden = !interval;
            timeField.hidden = interval;
            weekdayField.hidden = kind !== 'Weekly';
            weekdayInputs.forEach(input => input.disabled = kind !== 'Weekly');
            if (weekdaySentinel) weekdaySentinel.disabled = kind !== 'Weekly';
            if (intervalInput && intervalUnit)
                intervalInput.max = intervalUnit.value === 'Minutes' ? '1440' : '168';
            const selectedDays = weekdayInputs.filter(input => input.checked).map(input => input.closest('label')?.title || input.value);
            weekdayInputs[0]?.setCustomValidity(kind === 'Weekly' && selectedDays.length === 0 ? 'Bitte mindestens einen Wochentag auswählen.' : '');
            if (!summary) return;
            if (interval) {
                const amount = intervalInput?.value || '1';
                const unit = intervalUnit?.selectedOptions?.[0]?.textContent?.toLowerCase() || 'Stunden';
                summary.textContent = `Alle ${amount} ${unit}`;
            } else if (kind === 'Weekly') {
                summary.textContent = `${selectedDays.join(', ') || 'Keine Tage'} · ${timeInput?.value || '03:00'} Uhr`;
            } else {
                summary.textContent = `Täglich · ${timeInput?.value || '02:00'} Uhr`;
            }
        };

        kinds.forEach(input => input.addEventListener('change', updateScheduleFields));
        intervalUnit?.addEventListener('change', updateScheduleFields);
        intervalInput?.addEventListener('input', updateScheduleFields);
        timeInput?.addEventListener('input', updateScheduleFields);
        weekdayInputs.forEach(input => input.addEventListener('change', updateScheduleFields));
        updateScheduleFields();
    })();

    (() => {
        const attempts = document.getElementById('max-retry-attempts');
        const delayField = document.getElementById('retry-delay-field');
        if (!attempts || !delayField) return;
        const update = () => delayField.hidden = Number(attempts.value) <= 1;
        attempts.addEventListener('input', update);
        update();
    })();
</script>

<script>
    (() => {
        const source = document.getElementById('source-object');
        const dialog = document.getElementById('source-picker-dialog');
        const tree = document.getElementById('source-tree');
        const inputs = document.getElementById('selected-source-inputs');
        const title = document.getElementById('source-picker-title');
        const summary = document.getElementById('source-picker-summary');
        const count = document.getElementById('source-picker-count');
        const error = document.getElementById('source-picker-error');
        const supported = new Set(['LocalFolder', 'Smb', 'DockerVolume', 'Proxmox']);
        let selected = new Set(@Html.Raw(JsonSerializer.Serialize(Model.SelectedSourcePaths)));
        let draft = new Set(selected);

        const selectedOption = () => source?.selectedOptions?.[0];
        const updateSummary = () => {
            const values = [...selected].sort((a, b) => a.localeCompare(b, 'de'));
            title.textContent = values.length ? `${values.length} Ordner ausgewählt` : 'Gesamtes Object';
            summary.textContent = values.length ? values.join(' · ') : 'Alle Ordner und Dateien werden gesichert';
            inputs.replaceChildren(...values.map(path => {
                const input = document.createElement('input'); input.type = 'hidden'; input.name = 'SelectedSourcePaths'; input.value = path; return input;
            }));
        };
        const updateDraftCount = () => count.textContent = draft.size ? `${draft.size} Ordner ausgewählt` : 'Keine Einschränkung';
        const isCovered = path => [...draft].some(value => path === value || path.startsWith(value + '/'));
        const toggleDraft = (path, checked) => {
            if (checked) {
                for (const value of [...draft]) if (value.startsWith(path + '/')) draft.delete(value);
                draft.add(path);
            } else draft.delete(path);
            tree.querySelectorAll('input[data-path]').forEach(box => { box.checked = isCovered(box.dataset.path); });
            updateDraftCount();
        };
        const loadChildren = async (container, path = '') => {
            container.innerHTML = '<div class="source-tree-loading">Ordner werden geladen …</div>';
            error.hidden = true;
            try {
                const response = await fetch(`?handler=BrowseSource&objectId=${encodeURIComponent(source.value)}&path=${encodeURIComponent(path)}`);
                const payload = await response.json();
                if (!response.ok) throw new Error(payload.message || 'Ordner konnten nicht geladen werden.');
                container.replaceChildren();
                if (!payload.entries.length) { container.innerHTML = '<div class="source-tree-empty">Keine Unterordner</div>'; return; }
                for (const entry of payload.entries) {
                    const row = document.createElement('div'); row.className = 'source-tree-node';
                    const line = document.createElement('div'); line.className = 'source-tree-line';
                    const expand = document.createElement('button'); expand.type = 'button'; expand.className = 'source-tree-expand'; expand.textContent = '›'; expand.title = 'Unterordner laden';
                    const label = document.createElement('label');
                    const checkbox = document.createElement('input'); checkbox.type = 'checkbox'; checkbox.dataset.path = entry.path; checkbox.checked = isCovered(entry.path);
                    const name = document.createElement('span'); name.textContent = entry.name;
                    label.append(checkbox, name); line.append(expand, label); row.append(line);
                    if (entry.hasChildren === false) expand.hidden = true;
                    const children = document.createElement('div'); children.className = 'source-tree-children'; children.hidden = true; row.append(children);
                    checkbox.addEventListener('change', () => toggleDraft(entry.path, checkbox.checked));
                    expand.addEventListener('click', async () => { const opening = children.hidden; children.hidden = !opening; expand.classList.toggle('open', opening); if (opening && !children.dataset.loaded) { children.dataset.loaded = 'true'; await loadChildren(children, entry.path); } });
                    container.append(row);
                }
            } catch (reason) { container.replaceChildren(); error.textContent = reason.message; error.hidden = false; }
        };

        document.getElementById('source-picker-open').addEventListener('click', async () => {
            if (source.value && !supported.has(selectedOption()?.dataset.kind)) { error.textContent = 'Dieser Quelltyp bietet keine Inhaltsauswahl.'; error.hidden = false; dialog.showModal(); return; }
            if (!source.value) { error.textContent = 'Bitte zuerst ein Quell-Object auswählen.'; error.hidden = false; dialog.showModal(); return; }
            draft = new Set(selected); updateDraftCount(); dialog.showModal(); await loadChildren(tree);
        });
        document.getElementById('source-picker-all').addEventListener('click', () => { draft.clear(); tree.querySelectorAll('input[data-path]').forEach(box => box.checked = false); updateDraftCount(); });
        document.getElementById('source-picker-apply').addEventListener('click', () => { selected = new Set(draft); updateSummary(); dialog.close(); });
        for (const id of ['source-picker-close', 'source-picker-cancel']) document.getElementById(id).addEventListener('click', () => dialog.close());
        source.addEventListener('change', () => { selected.clear(); updateSummary(); });
        updateSummary();
    })();
</script>
