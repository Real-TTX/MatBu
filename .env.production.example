# Vor dem ersten Produktionsstart ändern (mindestens 12 Zeichen).
MATBU_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Standardmäßig ist Port 9293 nur auf dem Docker-Host erreichbar.
MATBU_BIND_ADDRESS=127.0.0.1

# Nur aktivieren, wenn MatBu ausschließlich hinter einem vertrauenswürdigen Reverse Proxy läuft.
MATBU_TRUST_FORWARD_HEADERS=true
